ves incluindo o jaó, a mexeriqueira, o maracanã-nobre, o beija-flor-safira, a guaracava-de-topete, o azulão-verdadeiro, o batuqueiro; quatro peixes: o guarú-listrado-do-cerrado, o pacu-prata, o trairão e bagrinho-de-emas; e um réptil, o lagarto-de-rabo-azul.","AnoCriacao":1982,"Esfera":"Estadual","nomParque":"EEc Jataí","valArea":9074.63},"id":496222}
