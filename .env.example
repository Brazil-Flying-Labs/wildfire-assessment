# Wildfire Assessment — configuração de ambiente
# Copie para .env e preencha. Nunca versione o .env.

# Core
DJANGO_SECRET_KEY=change-me-generate-a-new-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco (PostgreSQL)
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_HOST=db

# E-mail (console no dev; SMTP na VPS)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# GCP/GEE (arquivo de service account montado como somente leitura)
GEE_PRIVATE_KEY_FILE=/run/secrets/gcp-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
GCS_BUCKET_NAME=wildfire-analyser-outputs

# Storage (S3 atual; será substituído por GCS na Fase 2)
S3_BUCKET_NAME=your-s3-bucket-name

# IA (opcionais — a aplicação inicia sem elas)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Auth0 (será removido na migração para autenticação nativa)
SOCIAL_AUTH_AUTH0_DOMAIN=your-domain.auth0.com
SOCIAL_AUTH_AUTH0_KEY=your-client-id
SOCIAL_AUTH_AUTH0_SECRET=your-client-secret
SOCIAL_AUTH_AUTH0_SCOPE=openid,email,profile
AUTH0_API_AUDIENCE=your-auth0-api-audience
