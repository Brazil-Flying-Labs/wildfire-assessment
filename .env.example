# Wildfire Assessment — configuração de ambiente
# Copie para .env e preencha. Nunca versione o .env.

# Core
DJANGO_SECRET_KEY=change-me-generate-a-new-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco (PostgreSQL)
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_HOST=db

# E-mail (console no dev; SMTP na VPS)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# GCP/GEE (arquivo de service account montado como somente leitura)
GEE_PRIVATE_KEY_FILE=/run/secrets/gcp-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

# Storage (Google Cloud Storage)
GCS_BUCKET_NAME=wildfire-analyser-outputs
GCS_APP_BUCKET_NAME=wildfire-assessment-assets
GCS_APP_PREFIX=dev

# IA
AI_ENABLED=false
GEMINI_API_KEY=
OPENAI_API_KEY=

# Auth0 (será removido na migração para autenticação nativa)
SOCIAL_AUTH_AUTH0_DOMAIN=your-domain.auth0.com
SOCIAL_AUTH_AUTH0_KEY=your-client-id
SOCIAL_AUTH_AUTH0_SECRET=your-client-secret
SOCIAL_AUTH_AUTH0_SCOPE=openid,email,profile
AUTH0_API_AUDIENCE=your-auth0-api-audience

# UI (configuração pública, embutida no build do React — nunca segredos)
REACT_APP_WILDLIFE_API_URL=https://api.wildfire.droneai.com.br
REACT_APP_APP_ENVIRONMENT=production
REACT_APP_AUTH0_DOMAIN=your-domain.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-client-id
REACT_APP_AUTH0_AUDIENCE=your-auth0-api-audience
