{
  "title": "Wildfire - ECS",
  "uid": "wildfire-ecs",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["wildfire", "ecs", "containers", "aws"],
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "cluster",
        "label": "Cluster",
        "datasource": { "type": "prometheus" },
        "query": "label_values(aws_ecs_containerinsights_cpu_utilized_average, dimension_ClusterName)",
        "refresh": 2,
        "sort": 1
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": { "type": "prometheus" },
        "query": "label_values(aws_ecs_containerinsights_cpu_utilized_average{dimension_ClusterName=\"$cluster\"}, dimension_ServiceName)",
        "refresh": 2,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Task Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "CPU Used",
      "description": "CPU units currently in use by the active task. 256 units = 0.25 vCPU, 512 = 0.5 vCPU.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (dimension_ServiceName) (aws_ecs_containerinsights_cpu_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "CPU Usage %",
      "description": "Percentage of allocated CPU in use. Computed per-task then showing the highest (worst case).",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (dimension_ServiceName) (aws_ecs_containerinsights_cpu_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"} / (aws_ecs_containerinsights_cpu_reserved_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"} > 0)) * 100",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory Used",
      "description": "Memory in use by all containers in this task. Raw value is in MB, auto-formatted.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 400 },
              { "color": "red", "value": 800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (dimension_ServiceName) (aws_ecs_containerinsights_memory_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory Usage %",
      "description": "Percentage of allocated memory in use. Computed per-task then showing the highest (worst case). 100% = OOM risk.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max by (dimension_ServiceName) (aws_ecs_containerinsights_memory_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"} / (aws_ecs_containerinsights_memory_reserved_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"} > 0)) * 100",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "row",
      "title": "CPU & Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CPU Units: Used vs Limit",
      "description": "CPU units used over time vs the Fargate allocation (1024 = 1 vCPU). Gap between lines = headroom.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_cpu_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}} - utilized"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_cpu_reserved_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}} - reserved"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory (MB): Used vs Limit",
      "description": "Memory used over time vs the Fargate allocation. Gap between lines = headroom before OOM.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_memory_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}} - utilized"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_memory_reserved_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}} - reserved"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage %",
      "description": "Percentage of allocated CPU in use. 100% = task is at its CPU limit.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "(aws_ecs_containerinsights_cpu_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"} / aws_ecs_containerinsights_cpu_reserved_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}) * 100",
          "legendFormat": "{{dimension_ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage %",
      "description": "Percentage of allocated memory in use. 100% = task will OOM.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "(aws_ecs_containerinsights_memory_utilized_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"} / aws_ecs_containerinsights_memory_reserved_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}) * 100",
          "legendFormat": "{{dimension_ServiceName}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Network & Storage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Network Inbound (Bytes/s)",
      "description": "Data received by this task from the network.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_network_rx_bytes_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Outbound (Bytes/s)",
      "description": "Data sent by this task to the network.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_network_tx_bytes_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Read (Bytes/s)",
      "description": "Data read from ephemeral storage (20 GB default on Fargate).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_storage_read_bytes_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Write (Bytes/s)",
      "description": "Data written to ephemeral storage (20 GB default on Fargate).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "aws_ecs_containerinsights_storage_write_bytes_average{dimension_ClusterName=\"$cluster\",dimension_ServiceName=\"$service\"}",
          "legendFormat": "{{dimension_ServiceName}}"
        }
      ]
    }
  ]
}
