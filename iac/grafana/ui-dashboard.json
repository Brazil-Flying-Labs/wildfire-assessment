{
  "title": "Wildfire UI - Frontend",
  "uid": "wildfire-ui",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["frontend", "faro", "wildfire", "ui"],
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "environment",
        "label": "Environment",
        "query": "dev,development,local,prod",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "JS Errors",
      "description": "Total JavaScript errors in selected time range",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "sum(count_over_time({service_name=\"wildfire-ui\", kind=\"exception\", deployment_environment=~\"$environment\"} [$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Sessions",
      "description": "Total sessions started in selected time range",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "sum(count_over_time({service_name=\"wildfire-ui\", kind=\"event\", deployment_environment=~\"$environment\"} |= \"session_start\" [$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg LCP",
      "description": "Largest Contentful Paint — how fast the main content loads (< 2.5s good)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2500 },
              { "color": "red", "value": 4000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "avg_over_time({service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" lcp=\" | logfmt | unwrap lcp [$__range])",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg CLS",
      "description": "Cumulative Layout Shift — visual stability (< 0.1 good)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "avg_over_time({service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" cls=\" | logfmt | unwrap cls [$__range])",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "row",
      "title": "Web Vitals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "LCP — Largest Contentful Paint",
      "description": "How fast the main content loads. Good < 2.5s, Poor > 4s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p75" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.50, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" lcp=\" | logfmt | unwrap lcp [5m])",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.75, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" lcp=\" | logfmt | unwrap lcp [5m])",
          "legendFormat": "p75"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.95, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" lcp=\" | logfmt | unwrap lcp [5m])",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "FCP — First Contentful Paint",
      "description": "When the first content appears on screen. Good < 1.8s, Poor > 3s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p75" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.50, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" fcp=\" | logfmt | unwrap fcp [5m])",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.75, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" fcp=\" | logfmt | unwrap fcp [5m])",
          "legendFormat": "p75"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.95, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" fcp=\" | logfmt | unwrap fcp [5m])",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CLS — Cumulative Layout Shift",
      "description": "Visual stability. Good < 0.1, Poor > 0.25",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p75" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.50, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" cls=\" | logfmt | unwrap cls [5m])",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.75, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" cls=\" | logfmt | unwrap cls [5m])",
          "legendFormat": "p75"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.95, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" cls=\" | logfmt | unwrap cls [5m])",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TTFB — Time to First Byte",
      "description": "Server response time. Good < 800ms, Poor > 1800ms",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p75" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.50, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" ttfb=\" | logfmt | unwrap ttfb [5m])",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.75, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" ttfb=\" | logfmt | unwrap ttfb [5m])",
          "legendFormat": "p75"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.95, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" ttfb=\" | logfmt | unwrap ttfb [5m])",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "INP — Interaction to Next Paint",
      "description": "Responsiveness to user input. Good < 200ms, Poor > 500ms",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p75" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.50, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" inp=\" | logfmt | unwrap inp [5m])",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.75, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" inp=\" | logfmt | unwrap inp [5m])",
          "legendFormat": "p75"
        },
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "quantile_over_time(0.95, {service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" inp=\" | logfmt | unwrap inp [5m])",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Page Loads",
      "description": "Number of page loads over time (one TTFB measurement per page load)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": { "fillOpacity": 30, "lineWidth": 2, "spanNulls": true, "drawStyle": "bars" }
        },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "sum(count_over_time({service_name=\"wildfire-ui\", kind=\"measurement\", deployment_environment=~\"$environment\"} |= \" ttfb=\" [5m]))",
          "legendFormat": "Page loads"
        }
      ]
    },
    {
      "type": "row",
      "title": "Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "JS Errors Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": { "fillOpacity": 30, "lineWidth": 2, "spanNulls": true, "drawStyle": "bars" }
        },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "sum(count_over_time({service_name=\"wildfire-ui\", kind=\"exception\", deployment_environment=~\"$environment\"} [5m]))",
          "legendFormat": "Errors"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Errors",
      "description": "Most frequent error messages in selected time range",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "topk(10, sum by (value_template) (count_over_time({service_name=\"wildfire-ui\", kind=\"exception\", deployment_environment=~\"$environment\"} [$__range])))",
          "legendFormat": "{{value_template}}",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Error Log",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "collapsed": false
    },
    {
      "type": "logs",
      "title": "Recent Errors",
      "description": "Raw exception log entries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-diogohudson-logs" },
          "expr": "{service_name=\"wildfire-ui\", kind=\"exception\", deployment_environment=~\"$environment\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
