{
  "title": "Wildfire API - Django",
  "uid": "wildfire-django",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["django", "wildfire", "api"],
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "environment",
        "label": "Environment",
        "datasource": { "type": "prometheus" },
        "query": "label_values(http_server_duration_milliseconds_count{service_name=\"wildfire-api\"}, deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Request Rate",
      "description": "Requests per second (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Requests",
      "description": "Currently in-flight requests",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(http_server_active_requests{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg Latency",
      "description": "Average response time (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_duration_milliseconds_sum{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval])) / sum(rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "description": "Percentage of 5xx responses (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\", http_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "row",
      "title": "Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Requests / sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by Status Code",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 40, "lineWidth": 1, "stacking": { "mode": "normal" }, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "3.." }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_status_code}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Response Time Percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg Latency by Endpoint",
      "description": "Top 10 slowest endpoints",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "topk(10, sum by (http_target) (rate(http_server_duration_milliseconds_sum{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval])) / sum by (http_target) (rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{http_target}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Endpoints",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "bargauge",
      "title": "Top Endpoints (total requests)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "topk(10, sum by (http_target) (increase(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__range])) > 0)",
          "legendFormat": "{{http_target}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by Method",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 30, "lineWidth": 2, "stacking": { "mode": "normal" }, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (http_method) (rate(http_server_duration_milliseconds_count{service_name=\"wildfire-api\", http_host=\"api.droneai.com.br\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_method}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Celery Workers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false
    },
    {
      "type": "text",
      "title": "Celery Task Runs",
      "description": "View individual Celery task executions in Tempo",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 33 },
      "options": {
        "mode": "markdown",
        "content": "### [Celery Task Runs](https://brazilflyinglabs.grafana.net/explore?schemaVersion=1&panes=%7B%22main%22%3A%7B%22datasource%22%3A%22grafanacloud-brazilflyinglabs-traces%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22wildfire-celery-worker%5C%22%20%26%26%20duration%20%3E%201s%7D%22%7D%5D%7D%7D)\n\nClick to view task executions with timing and status in Tempo."
      }
    }
  ]
}
