# AWS Configuration
aws_region  = "us-east-1"
aws_profile = "bfl"  # Your AWS profile name

# Project Configuration
project_name = "wildfire-assessment"
environment  = "dev"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"
az_count = 2

