{
    "family": "wildfire-assessment-api-dev",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::055213706289:role/wildfire-assessment-exec-dev",
    "taskRoleArn": "arn:aws:iam::055213706289:role/wildfire-assessment-task-dev",
    "containerDefinitions": [
        {
            "name": "api",
            "image": "REPLACED_BY_ACTION",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 10000,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/wildfire-assessment-dev",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "api"
                }
            },
            "linuxParameters": {
                "initProcessEnabled": true
            },
            "environment": [
                {
                    "name": "ENVIRONMENT",
                    "value": "dev"
                }
            ]
        }
    ],
    "runtimePlatform": {
        "operatingSystemFamily": "LINUX",
        "cpuArchitecture": "X86_64"
    }
}